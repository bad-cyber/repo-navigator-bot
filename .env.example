# Telegram Bot (создайте нового бота у @BotFather для навигатора по репозиториям)
BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API (бесплатный ключ на openrouter.ai)
LLM_API_KEY=sk-or-v1-your_openrouter_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free

# Qdrant Vector DB (порт 6335, чтобы не пересекаться с первым проектом)
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=code_chunks
